# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase project (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared app password (this app has a single personal user, not accounts)
APP_PASSWORD=

# Random long string used to sign session cookies, e.g. `openssl rand -base64 32`
SESSION_SECRET=
